# Na maquina local a API roda em http://localhost:3000.
PORT=3000
# Arquivo de contas em volume persistente, fora da pasta publica do site.
DATABASE_PATH=./storage/contas.sqlite
# Origem publica do seu GitHub Pages; pode incluir outros dominios exatos separados por virgula.
ALLOWED_ORIGINS=https://miguelferreira08.github.io,http://localhost:3000
# Somente para telemetria: a conta do site NAO usa Firebase Authentication.
FIREBASE_DATABASE_URL=https://projeto-varal-ca245-default-rtdb.firebaseio.com
# NUNCA coloque a chave privada no repositório ou em site_online/config.js.
# Configure UMA opcao: caminho de credencial local ou JSON completo como segredo no provedor.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/privado/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
